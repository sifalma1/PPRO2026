{
  "name": "akademie-trutnov-is",
  "version": "1.0.0",
  "type": "module",
  "description": "Informační systém pro vzdělávací centrum Akademie Trutnov (PPRO 2026)",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "migrate": "tsx src/infrastructure/database/migrate.ts",
    "test": "node --import tsx --test test/**/*.test.ts"
